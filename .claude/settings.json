{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(terraform init*)",
      "Bash(terraform validate*)",
      "Bash(terraform fmt*)",
      "Bash(terraform plan*)",
      "Bash(terraform show*)",
      "Bash(terraform output*)",
      "Bash(terraform state list*)",
      "Bash(terraform state show*)",
      "Bash(terraform providers*)",
      "Bash(terraform version*)",
      "Bash(aws sts get-caller-identity*)",
      "Bash(aws ec2 describe-*)",
      "Bash(aws iam list-*)",
      "Bash(aws iam get-*)",
      "Bash(aws s3 ls*)",
      "Bash(aws s3api list-*)",
      "Bash(aws ce get-cost*)",
      "Bash(az account show*)",
      "Bash(az account list*)",
      "Bash(az group list*)",
      "Bash(az network vnet list*)",
      "Bash(az network vnet show*)",
      "Bash(az resource list*)",
      "Bash(az consumption usage list*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push origin*)",
      "Bash(gh pr*)",
      "Bash(gh issue*)",
      "Bash(gh repo view*)"
    ],
    "ask": [
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform import*)",
      "Bash(terraform state rm*)",
      "Bash(terraform state mv*)",
      "Bash(aws iam create-*)",
      "Bash(aws iam delete-*)",
      "Bash(aws iam attach-*)",
      "Bash(aws iam put-*)",
      "Bash(aws ec2 create-*)",
      "Bash(aws ec2 delete-*)",
      "Bash(aws ec2 terminate-*)",
      "Bash(az group create*)",
      "Bash(az group delete*)",
      "Bash(az ad sp create*)",
      "Bash(az ad sp delete*)",
      "Bash(git push --force*)",
      "Bash(gh pr merge*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push origin main*)",
      "Bash(git push --force origin main*)",
      "Bash(terraform destroy --auto-approve --target=*)",
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  },
  "env": {
    "TF_IN_AUTOMATION": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-write.sh"
          }
        ]
      }
    ]
  }
}
