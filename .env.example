# Copy to .env and fill in values. .env is gitignored — never commit real credentials.
# Source this file before running terraform:  set -a && source .env && set +a

# ---- AWS ----
# IAM user with programmatic access (deploy user). Scope to least privilege per lab.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---- Azure ----
# Service principal (app registration) used by the AzureRM provider.
# az ad sp create-for-rbac --name "cross-cloud-labs-tf" --role Contributor --scopes /subscriptions/<SUB_ID>
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=
ARM_SUBSCRIPTION_ID=

# ---- Lab tagging (used by teardown filters) ----
LAB_OWNER=
LAB_PROJECT=cross-cloud-labs
